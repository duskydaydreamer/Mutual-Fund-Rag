# LLM Provider
GROQ_API_KEY=your_groq_api_key_here

# Embedding Model
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# LLM Model
LLM_MODEL=llama-3.1-70b-versatile
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=200

# Retrieval
TOP_K=5
SCORE_THRESHOLD=0.65

# ChromaDB
CHROMA_PERSIST_DIR=./data/vectorstore
CHROMA_COLLECTION=mutual_fund_faq
